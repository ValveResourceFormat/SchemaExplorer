{
  "private": true,
  "name": "s2v-schema-explorer",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "tsc": "react-router typegen && tsc",
    "dev": "node scripts/compress-schemas.ts && react-router dev",
    "build": "node scripts/compress-schemas.ts && react-router build && node scripts/flatten-prerender.ts && node scripts/generate-llms.ts",
    "lastmod": "node scripts/generate-lastmod.ts",
    "sitemap": "node scripts/generate-sitemap.ts",
    "preview": "vite preview",
    "lint": "oxlint --react-perf-plugin --jsx-a11y-plugin react-router.config.ts vite.config.ts src scripts",
    "fmt": "oxfmt react-router.config.ts vite.config.ts src scripts",
    "test": "tsc && oxlint --react-perf-plugin --jsx-a11y-plugin react-router.config.ts vite.config.ts src scripts && vitest run --reporter=dot && oxfmt --check react-router.config.ts vite.config.ts src scripts",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@floating-ui/react": "^0.27.20",
    "@react-router/node": "^8.5.2",
    "@tanstack/react-virtual": "^3.14.28",
    "inter-ui": "^4.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.2"
  },
  "devDependencies": {
    "@linaria/react": "^8.3.0",
    "@react-router/dev": "^8.5.2",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@wyw-in-js/vite": "2.4.4",
    "oxfmt": "^0.80.0",
    "oxlint": "^1.95.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
